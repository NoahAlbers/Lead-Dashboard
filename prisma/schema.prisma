generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INTAKE
  SALES
  MANAGER
}

enum LeadStatus {
  NEW
  REVIEWED
  QUALIFIED
  CONTACTED
  FOLLOW_UP_NEEDED
  REFERRED_OUT
  IMPORTED_TO_CRM
  WON
  LOST
  DISQUALIFIED
  DUPLICATE
  ARCHIVED
  MERGED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(INTAKE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Admin polish: sign-in tracking + invite flow
  lastActiveAt    DateTime? @map("last_active_at")
  inviteToken     String?   @unique @map("invite_token")
  inviteExpiresAt DateTime? @map("invite_expires_at")

  assignedLeads  Lead[]          @relation("AssignedUser")
  leadEvents     LeadEvent[]
  leadNotes      LeadNote[]
  savedViews     SavedView[]
  emailTemplates EmailTemplate[] @relation("TemplateCreator")

  // Phase 2 relations
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  soundPreference         SoundPreference?
  followUpReminders       FollowUpReminder[]
  recordedOutcomes        LeadOutcome[] @relation("RecordedOutcomes")

  @@map("users")
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Source
  source     String?
  leadSource String? @map("lead_source")
  sourcePage String? @map("source_page")
  utmSource  String? @map("utm_source")
  utmMedium  String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  referrer   String?

  // Identity / Contact
  firstName      String? @map("first_name")
  lastName       String? @map("last_name")
  fullName       String? @map("full_name")
  companyName    String? @map("company_name")
  title          String?
  email          String?
  phone          String?
  alternatePhone String? @map("alternate_phone")

  // Location
  address1 String? @map("address_1")
  address2 String? @map("address_2")
  city     String?
  state    String?
  states   Json?     @map("states") // string[] of all selected states
  zip      String?
  country  String?

  // Business / Case Data
  industry            String?
  debtType            String?  @map("debt_type")
  balanceAmount       Decimal? @map("balance_amount") @db.Decimal(12, 2)
  estimatedClaimValue Decimal? @map("estimated_claim_value") @db.Decimal(12, 2)
  accountVolume       String?  @map("account_volume")
  accountVolumeNum    Int?     @map("account_volume_num") // derived numeric copy for filtering/sorting
  avgRentNum          Int?     @map("avg_rent_num")       // avg rent/unit, derived from raw intake payload
  serviceRequested    String?  @map("service_requested")
  notesFromForm       String?  @map("notes_from_form") @db.Text
  urgency             String?
  businessType        String?  @map("business_type")
  geographicScope     String?  @map("geographic_scope")

  // Raw payload
  rawPayloadJson Json? @map("raw_payload_json")

  // Internal / Derived
  status            LeadStatus  @default(NEW)
  score             Int?
  qualityTier       String? @map("quality_tier")
  recommendedAction String?      @map("recommended_action")
  scoreReasons      Json?        @map("score_reasons")
  lastActivityAt    DateTime?    @map("last_activity_at")

  // Read/Unread
  isRead Boolean @default(false) @map("is_read")
  // Lead was created from an abandoned (incomplete) form session
  fromAbandonedForm Boolean @default(false) @map("from_abandoned_form")
  // Experiment variants the prospect saw in the intake form ({experiment_key: variant_key})
  formVariants      Json?   @map("form_variants")

  // CRM
  crmStatus     String? @map("crm_status")
  crmExternalId String? @map("crm_external_id")

  // SLA Tracking (Phase 2)
  firstContactAt DateTime? @map("first_contact_at")
  slaStatus      String?   @map("sla_status")
  slaBreachedAt  DateTime? @map("sla_breached_at")

  // Assignment (Phase 3)
  assignedAt    DateTime? @map("assigned_at")
  claimedBySelf Boolean   @default(false) @map("claimed_by_self")

  // Follow-Up (Phase 4)
  nextFollowUpAt DateTime? @map("next_follow_up_at")

  // Merge (Phase 5)
  mergedIntoLeadId String?   @map("merged_into_lead_id")
  mergedIntoLead   Lead?     @relation("MergedLeads", fields: [mergedIntoLeadId], references: [id])
  mergedFromLeads  Lead[]    @relation("MergedLeads")
  mergedAt         DateTime? @map("merged_at")

  // Relations
  assignedUserId      String?          @map("assigned_user_id")
  assignedUser        User?            @relation("AssignedUser", fields: [assignedUserId], references: [id])
  recommendedReferralId String?        @map("recommended_referral_id")
  recommendedReferral   ReferralPartner? @relation("RecommendedReferral", fields: [recommendedReferralId], references: [id])
  duplicateOfLeadId   String?          @map("duplicate_of_lead_id")
  duplicateOfLead     Lead?            @relation("DuplicateLeads", fields: [duplicateOfLeadId], references: [id])
  duplicateLeads      Lead[]           @relation("DuplicateLeads")

  events          LeadEvent[]
  notes           LeadNote[]
  crmExports      CrmExport[]
  notifications   Notification[]
  followUpReminders FollowUpReminder[]
  assignmentLogs  AssignmentLog[]
  mergeHistoryPrimary   MergeHistory[] @relation("MergePrimary")
  mergeHistoryDuplicate MergeHistory[] @relation("MergeDuplicate")
  outcome               LeadOutcome?
  ingestionQueue        IngestionQueue[]
  recaptureEnrollment   RecaptureEnrollment?

  @@index([status])
  @@index([qualityTier])
  @@index([createdAt])
  @@index([assignedUserId])
  @@index([email])
  @@index([companyName])
  @@index([slaStatus])
  @@index([nextFollowUpAt])
  @@index([score])
  @@index([accountVolumeNum])
  @@index([avgRentNum])
  @@map("leads")
}

model LeadEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  eventType    String @map("event_type")
  eventDataJson Json?  @map("event_data_json")

  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([eventType])
  @@map("lead_events")
}

model LeadNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  noteBody String @map("note_body") @db.Text

  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_notes")
}

model ScoringRule {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  enabled     Boolean  @default(true)
  priority    Int      @default(0)

  conditionsJson Json @map("conditions_json")
  outcomesJson   Json @map("outcomes_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scoring_rules")
}

model ReferralPartner {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  contactName String? @map("contact_name")
  email       String?
  emails      Json?   @map("emails") // string[] for multiple emails
  phone       String?
  website     String?
  customFields Json?  @map("custom_fields") // Record<string, unknown>

  statesServedJson      Json? @map("states_served_json")
  industriesServedJson  Json? @map("industries_served_json")
  specialtiesJson       Json? @map("specialties_json")
  preferredLeadTypesJson Json? @map("preferred_lead_types_json")

  minimumClaimSize Decimal? @map("minimum_claim_size") @db.Decimal(12, 2)
  maximumClaimSize Decimal? @map("maximum_claim_size") @db.Decimal(12, 2)

  exclusionsJson Json?   @map("exclusions_json")
  notes          String? @db.Text

  // Financial Terms
  contingencyRate     String? @map("contingency_rate")
  upfrontCosts        String? @map("upfront_costs")
  paymentTerms        String? @map("payment_terms")
  commissionStructure String? @map("commission_structure")

  // Account Requirements
  minimumAccounts     Int?     @map("minimum_accounts")
  minimumTotalBalance Decimal? @map("minimum_total_balance") @db.Decimal(12, 2)
  avgAccountAgePref   String?  @map("avg_account_age_preference")
  accountTypesAccepted String? @map("account_types_accepted")

  // Service Details
  collectionMethods  String? @map("collection_methods")
  licensedStatesJson Json?   @map("licensed_states_json")
  insuranceInfo      String? @map("insurance_info")
  yearsInBusiness    Int?    @map("years_in_business")
  complianceNotes    String? @map("compliance_notes") @db.Text

  defaultEmailTemplateId String?        @map("default_email_template_id")
  defaultEmailTemplate   EmailTemplate? @relation(fields: [defaultEmailTemplateId], references: [id])

  rankingPriority Int @default(0) @map("ranking_priority")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recommendedLeads Lead[] @relation("RecommendedReferral")
  outcomes         LeadOutcome[] @relation("OutcomeReferral")

  @@map("referral_partners")
}

model EmailType {
  id         String  @id @default(cuid())
  name       String
  color      String  @default("#B3D4FF")
  isReferral Boolean @default(false) @map("is_referral")
  isDefault  Boolean @default(false) @map("is_default")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  templates EmailTemplate[]

  @@map("email_types")
}

model EmailTemplate {
  id   String @id @default(cuid())
  name String
  type String // legacy string type

  emailTypeId String?    @map("email_type_id")
  emailType   EmailType? @relation(fields: [emailTypeId], references: [id])

  subjectTemplate String @map("subject_template")
  bodyTemplate    String @map("body_template") @db.Text
  active          Boolean @default(true)

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("TemplateCreator", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  referralPartners ReferralPartner[]

  @@map("email_templates")
}

model SavedView {
  id   String @id @default(cuid())
  name String

  filtersJson   Json?   @map("filters_json")
  sortJson      Json?   @map("sort_json")
  columnsJson   Json?   @map("columns_json")
  isSystem      Boolean @default(false) @map("is_system")
  isTeamView    Boolean @default(false) @map("is_team_view")
  hiddenByUsers Json?   @map("hidden_by_users") // string[] of userIds
  isPinned      Boolean @default(false) @map("is_pinned")
  sortOrder     Int     @default(0) @map("sort_order")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("saved_views")
}

model CrmExport {
  id         String  @id @default(cuid())
  systemName String  @map("system_name")
  status     String  // pending, success, failed

  payloadJson  Json?    @map("payload_json")
  externalId   String?  @map("external_id")
  errorMessage String?  @map("error_message")

  attemptedAt DateTime  @default(now()) @map("attempted_at")
  completedAt DateTime? @map("completed_at")

  leadId String @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("crm_exports")
}

model StateClassification {
  id             String  @id @default(cuid())
  stateAbbrev    String  @unique @map("state_abbrev")
  stateName      String  @map("state_name")
  classification String  @default("unknown") // "good", "banned", "unknown"
  note           String? @db.Text
  active         Boolean @default(true)

  @@map("state_classifications")
}

model CustomStatus {
  id        String   @id @default(cuid())
  name      String
  color     String
  type      String   // "status" or "tier"
  sortOrder Int      @default(0) @map("sort_order")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("custom_statuses")
}

// ===== Phase 2: Notification System =====

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // new_lead, lead_assigned, sla_warning, sla_breach, sla_escalation, follow_up_due, etc.
  title    String
  body     String
  priority NotificationPriority @default(NORMAL)

  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  read    Boolean   @default(false)
  readAt  DateTime? @map("read_at")
  clicked Boolean   @default(false)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String
  keysJson  Json   @map("keys_json")
  userAgent String? @map("user_agent")
  active    Boolean @default(true)

  @@map("push_subscriptions")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId           String @map("user_id")
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType    String  @map("notification_type")
  browserPushEnabled  Boolean @default(true) @map("browser_push_enabled")
  inAppEnabled        Boolean @default(true) @map("in_app_enabled")
  soundEnabled        Boolean @default(true) @map("sound_enabled")

  @@unique([userId, notificationType])
  @@map("notification_preferences")
}

model SoundPreference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId        String  @unique @map("user_id")
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  soundsEnabled Boolean @default(true) @map("sounds_enabled")
  volume        Int     @default(70)

  @@map("sound_preferences")
}

// ===== Phase 2: SLA Tracking =====

model SlaConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  qualityTier         String @unique @map("quality_tier")
  firstContactMinutes Int    @map("first_contact_minutes")
  followUpMinutes     Int    @map("follow_up_minutes")
  escalationMinutes   Int?   @map("escalation_minutes")

  @@map("sla_config")
}

model OfficeHoursConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  startTime  String @default("09:00") @map("start_time")
  endTime    String @default("16:00") @map("end_time")
  activeDays Json   @default("[1,2,3,4,5]") @map("active_days")
  timezone   String @default("America/New_York")

  @@map("office_hours_config")
}

model OfficeHoursHoliday {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  date DateTime @db.Date
  name String

  @@map("office_hours_holidays")
}

// ===== Phase 3: Assignment =====

model AssignmentLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  leadId          String  @map("lead_id")
  lead            Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId      String? @map("from_user_id")
  toUserId        String? @map("to_user_id")
  assignedByUserId String @map("assigned_by_user_id")
  reason          String?

  @@index([leadId])
  @@map("assignment_log")
}

// ===== Phase 4: Follow-Up Reminders =====

model FollowUpReminder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  leadId     String @map("lead_id")
  lead       Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id])

  reminderAt  DateTime @map("reminder_at")
  note        String?
  completed   Boolean  @default(false)
  completedAt DateTime? @map("completed_at")
  notifiedAt  DateTime? @map("notified_at")

  @@index([leadId])
  @@index([userId, completed])
  @@map("follow_up_reminders")
}

// ===== Phase 5: Duplicate Merge =====

model MergeHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  primaryLeadId   String @map("primary_lead_id")
  primaryLead     Lead   @relation("MergePrimary", fields: [primaryLeadId], references: [id])
  duplicateLeadId String @map("duplicate_lead_id")
  duplicateLead   Lead   @relation("MergeDuplicate", fields: [duplicateLeadId], references: [id])
  mergedByUserId  String @map("merged_by_user_id")

  primarySnapshotJson   Json @map("primary_snapshot_json")
  duplicateSnapshotJson Json @map("duplicate_snapshot_json")
  fieldSelectionsJson   Json @map("field_selections_json")

  undone         Boolean   @default(false)
  undoneAt       DateTime? @map("undone_at")
  undoneByUserId String?   @map("undone_by_user_id")

  @@index([primaryLeadId])
  @@index([duplicateLeadId])
  @@map("merge_history")
}

// ===== Phase 2: System Configuration =====

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("system_config")
}

// Automated win-back sequence for leads created from abandoned form sessions.
// One enrollment per lead; the recapture cron advances currentStep until a
// stop condition fires (completion, reply/contact, unsubscribe, 3 sends).
model RecaptureEnrollment {
  id              String    @id @default(cuid())
  leadId          String    @unique @map("lead_id")
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sessionId       String?   @map("session_id")
  email           String
  resumeToken     String    @unique @map("resume_token")
  status          String    @default("active") // active, converted, stopped, exhausted
  stopReason      String?   @map("stop_reason")
  currentStep     Int       @default(0) @map("current_step") // emails sent so far
  nextSendAt      DateTime? @map("next_send_at")
  lastSentAt      DateTime? @map("last_sent_at")
  abandonedStep   String?   @map("abandoned_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, nextSendAt])
  @@index([email])
  @@map("recapture_enrollments")
}

// Addresses we must never email again (unsubscribes, bounces, complaints).
// Checked before every lead-facing automated send.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   // unsubscribed, bounced, complained, manual
  source    String?  // what triggered it (confirmation, recapture, resend_webhook)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_suppressions")
}

// ===== Phase 2: Win/Loss Analysis =====

model LeadOutcome {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  leadId String @unique @map("lead_id")
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  outcomeType    String  @map("outcome_type") // won, lost, disqualified, referred_out
  reason         String   // kept for backward compat: first selected reason
  reasons        String[] @default([]) // all selected reasons (multi-select)
  reasonDetail   String? @map("reason_detail") @db.Text
  competitor     String?
  couldHaveWon   String? @map("could_have_won") // yes, maybe, no
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(12, 2)
  estimatedAnnualRevenue Decimal? @map("estimated_annual_revenue") @db.Decimal(12, 2)
  accountVolume  Int?    @map("account_volume")

  referralPartnerId String?          @map("referral_partner_id")
  referralPartner   ReferralPartner? @relation("OutcomeReferral", fields: [referralPartnerId], references: [id])

  notes          String? @db.Text
  outcomeDate    DateTime @map("outcome_date")

  recordedByUserId String @map("recorded_by_user_id")
  recordedByUser   User   @relation("RecordedOutcomes", fields: [recordedByUserId], references: [id])

  @@index([outcomeType])
  @@index([outcomeDate])
  @@map("lead_outcomes")
}

model OutcomeReasonConfig {
  id          String  @id @default(cuid())
  outcomeType String  @map("outcome_type") // won, lost, disqualified, referred_out
  reasonText  String  @map("reason_text")
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)

  @@map("outcome_reason_config")
}

// ===== Zero-Loss Ingestion Pipeline =====

model IngestionQueue {
  id            String    @id @default(cuid())
  submissionId  String    @unique @map("submission_id")
  sessionId     String?   @map("session_id")
  status        String    @default("received") // received, partial, processing, completed, failed, duplicate
  isPartial     Boolean   @default(false) @map("is_partial")
  partialStep   String?   @map("partial_step")
  rawPayload    Json      @map("raw_payload")
  leadId        String?   @map("lead_id")
  lead          Lead?     @relation(fields: [leadId], references: [id])
  receiptId     String?   @map("receipt_id")
  formVersion   String?   @map("form_version")
  sourceIp      String?   @map("source_ip")
  errorMessage  String?   @map("error_message") @db.Text
  retryCount    Int       @default(0) @map("retry_count")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  formOpenedAt    DateTime? @map("form_opened_at")
  userAgent       String?   @map("user_agent")
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([status])
  @@index([receivedAt])
  @@map("ingestion_queue")
}

model ReceiptSequence {
  id      String @id @default(cuid())
  year    Int    @unique
  lastNum Int    @default(0) @map("last_num")

  @@map("receipt_sequence")
}

model ReconciliationLog {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now()) @map("created_at")
  periodStart         DateTime @map("period_start")
  periodEnd           DateTime @map("period_end")
  submissionsReceived Int      @map("submissions_received")
  leadsCreated        Int      @map("leads_created")
  duplicates          Int
  failures            Int
  partials            Int
  discrepancy         Boolean
  details             Json?

  @@map("reconciliation_logs")
}


// ===== Intake form flow tracking + experiments =====

// One row per visitor session in the intake form (same session id the form
// uses for partials/heartbeats). Updated by every event batch.
model FormSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique @map("session_id")
  startedAt     DateTime @default(now()) @map("started_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  formVersion   String?  @map("form_version")
  variantsJson  Json?    @map("variants_json")
  utmSource     String?  @map("utm_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  referrer      String?
  sourcePage    String?  @map("source_page")
  device        String?
  timezone      String?
  geoCity       String?  @map("geo_city")
  geoRegion     String?  @map("geo_region")
  geoCountry    String?  @map("geo_country")
  ip            String?
  furthestStep  String?  @map("furthest_step")
  furthestIndex Int      @default(0) @map("furthest_index")
  reachedContact Boolean @default(false) @map("reached_contact")
  outcome       String   @default("open") // open | completed | abandoned
  leadId        String?  @map("lead_id")
  eventCount    Int      @default(0) @map("event_count")
  // What the visitor has typed so far, refreshed with each batch, so staff can
  // see a form in progress. Cleared of blanks by the events route.
  answersJson   Json?     @map("answers_json")
  answersAt     DateTime? @map("answers_at")
  // How many times they came back after leaving the form open and going quiet.
  returnCount   Int       @default(0) @map("return_count")
  // What kind of connection they are on (VPN, datacenter, phone network),
  // looked up once per session so staff know what they are calling into.
  ipType        String?   @map("ip_type")
  ipIsp         String?   @map("ip_isp")

  @@index([startedAt])
  @@index([outcome])
  @@index([leadId])
  @@map("form_sessions")
}

// Append-only stream of what happened in a form session.
model FormEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  at        DateTime
  type      String   // view | step_enter | step_exit | pitch_view | submit | abandon | resume | validation_error
  step      String?
  elapsedMs Int?     @map("elapsed_ms")
  metaJson  Json?    @map("meta_json")

  @@index([sessionId, at])
  @@index([type, at])
  @@map("form_events")
}

// A/B experiments the form reads from /api/form/config.
model Experiment {
  id           String    @id @default(cuid())
  key          String    @unique
  name         String
  hypothesis   String?
  status       String    @default("draft") // draft | running | paused | ended
  primaryGoal  String    @default("completed") @map("primary_goal") // completed | contact_reached | hot_lead
  variantsJson Json      @map("variants_json") // [{key, weight, description, flags}]
  startedAt    DateTime? @map("started_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("experiments")
}
